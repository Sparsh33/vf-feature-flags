ENV=local
MONGO_URI=mongodb://mongo:27017
MONGO_DB=vf_feature_flags
# Redis AUTH — keep in sync with REDIS_URL / CELERY_BROKER_URL.
# Compose substitutes REDIS_PASSWORD into the URLs by default, so
# overriding REDIS_URL / CELERY_BROKER_URL is only needed to point
# at an external Redis.
REDIS_PASSWORD=local-dev-redis
REDIS_URL=redis://:local-dev-redis@redis:6379/0
CELERY_BROKER_URL=redis://:local-dev-redis@redis:6379/1
# Required. Generate locally with: openssl rand -hex 32
# The app refuses to boot when ENV != local and JWT_SECRET is a well-known default.
JWT_SECRET=change-me-in-prod
JWT_TTL_MINUTES=1440
ANTHROPIC_API_KEY=
NL_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
NL_INPUT_TOKEN_BUDGET=8192
NL_COMPACTION_TRIGGER=0.70
CORS_ORIGINS=http://localhost:5173
